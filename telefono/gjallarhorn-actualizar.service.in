# Plantilla: `make auto` la rellena. Un solo disparo cada vez; el timer manda.
[Unit]
Description=gjallarhorn: git pull --ff-only y reinicia si cambió algo

[Service]
Type=oneshot
WorkingDirectory=@RAIZ@
# Desde el ADR-024, hugin ya no es un submódulo (ADR-019, histórico): vive
# dentro de este mismo repo, así que un `git pull` normal ya trae sus
# cambios con todo lo demás. Antes había un `git submodule update
# --init --recursive` aquí — con el repo unificado no hay submódulo que
# traer, así que no hacía nada salvo alargar cada ciclo del timer.
ExecStart=/bin/sh -c 'antes=$(git rev-parse HEAD); git pull -q --ff-only || exit 0; test "$antes" != "$(git rev-parse HEAD)" || exit 0; make -s reiniciar'
